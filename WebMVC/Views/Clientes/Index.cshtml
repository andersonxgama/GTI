@model List<WebMVC.Models.Cliente>

@{
    ViewBag.Title = "Clientes";
}

<link href="~/CSS/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2>Cliente</h2>

    @using (Html.BeginForm("Create", "Clientes", FormMethod.Post))
    {
        <!-- CLIENTE -->
        <div class="row mb-3">
            <div class="col-md-4">
                @Html.Label("CPF")
                @Html.TextBox("CPF", null, new { @class = "form-control", maxlength = 14 })
            </div>
            <div class="col-md-8">
                @Html.Label("Nome")
                @Html.TextBox("Nome", null, new { @class = "form-control" })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-2">
                @Html.Label("RG")
                @Html.TextBox("RG", null, new { @class = "form-control", maxlength = 12 })
            </div>
            <div class="col-md-3">
                @Html.Label("DataExpedicao")
                @Html.TextBox("DataExpedicao", null, new
                {
                    @type = "date",
                    @class = "form-control",
                    required = "required"
                })
            </div>
            <div class="col-md-4">
                @Html.Label("OrgaoExpedicao")
                @Html.TextBox("OrgaoExpedicao", null, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.Label("UFExpedicao")
                @Html.TextBox("UFExpedicao", null, new { @class = "form-control", maxlength = 2 })
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                @Html.Label("DataNascimento")
                @Html.TextBox("DataNascimento", null, new
                {
                    @type = "date",
                    @class = "form-control",
                    required = "required"
                })
            </div>
            <div class="col-md-2">
                @Html.Label("Sexo")
                @Html.DropDownList("Sexo", new List<SelectListItem>
                {
                    new SelectListItem { Text = "Selecione", Value = "" },
                    new SelectListItem { Text = "Masculino", Value = "M" },
                    new SelectListItem { Text = "Feminino", Value = "F" }
                }, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.Label("EstadoCivil")
                @Html.TextBox("EstadoCivil", null, new { @class = "form-control" })
            </div>
        </div>

        <!-- ENDEREÇO -->
        <h3>Endereço</h3>

        <div class="row mb-3">
            <div class="col-md-2">
                @Html.Label("CEP")
                @Html.TextBox("Endereco.CEP", null, new { @class = "form-control", maxlength = 9 })
            </div>
            <div class="col-md-4">
                @Html.Label("Logradouro")
                @Html.TextBox("Endereco.Logradouro", null, new { @class = "form-control" })
            </div>
            <div class="col-md-1">
                @Html.Label("Numero")
                @Html.TextBox("Endereco.Numero", null, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.Label("Complemento")
                @Html.TextBox("Endereco.Complemento", null, new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                @Html.Label("Bairro")
                @Html.TextBox("Endereco.Bairro", null, new { @class = "form-control" })
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                @Html.Label("Cidade")
                @Html.TextBox("Endereco.Cidade", null, new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                @Html.Label("UF")
                @Html.TextBox("Endereco.UF", null, new { @class = "form-control", maxlength = 2 })
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Salvar</button>
    }

    <hr />

    <!-- GRID -->
    <h3>Clientes Cadastrados</h3>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>RG</th>
                <th>Data Nascimento</th>
                <th>Sexo</th>
                <th>Estado Civil</th>
                <th>Endereço</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nome</td>
                    <td>@cliente.CPF</td>
                    <td>@cliente.RG</td>
                    <td>@cliente.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@cliente.Sexo</td>
                    <td>@cliente.EstadoCivil</td>
                    <td>
                        @(cliente.Endereco != null
                            ? $"{cliente.Endereco.Logradouro}, {cliente.Endereco.Numero}, {cliente.Endereco.Bairro}, {cliente.Endereco.Cidade} - {cliente.Endereco.UF}"
                            : "")
                    </td>
                    <td>
                        @Html.ActionLink(
                                 "Editar",
                                 "Edit",
                                 "Clientes",
                                 new { id = cliente.Id },
                                 new { @class = "btn btn-sm btn-outline-primary" }
                             )
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>